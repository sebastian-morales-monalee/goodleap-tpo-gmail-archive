# GoodLeap TPO Gmail Archive - Apps Script property reference
#
# Google Apps Script does NOT load this file at runtime. Copy these key/value
# pairs into Apps Script > Project Settings > Script Properties.
# Never rename this file to .env with real credentials inside the repository.

# Required OpenAI properties
OPENAI_API_KEY=sk-proj_REPLACE_WITH_PROJECT_API_KEY
OPENAI_MODEL=gpt-5.4-mini
OPENAI_PDF_MODEL=gpt-5.4-mini

# Optional OpenAI analysis controls
# Keep the batch bounded to protect Apps Script execution time and API spend.
OPENAI_ANALYSIS_BATCH_SIZE=10
OPENAI_MAX_EMAIL_CHARACTERS=30000

# Optional OpenAI Shade Report PDF controls
# The existing OPENAI_API_KEY authenticates both email and PDF requests.
OPENAI_PDF_BATCH_SIZE=2
OPENAI_PDF_MAX_FILE_BYTES=15728640

# Required PostHog properties
POSTHOG_HOST=https://us.posthog.com
POSTHOG_PROJECT_ID=REPLACE_WITH_NUMERIC_ENVIRONMENT_ID
POSTHOG_PERSONAL_API_KEY=phx_REPLACE_WITH_PERSONAL_API_KEY

# Optional PostHog mapping overrides
# The defaults below match the confirmed GoodLeap and Artemis Sales schemas.
POSTHOG_GOODLEAP_LOOKUP_TABLE=goodleap_postgres_financiers
POSTHOG_ARTEMIS_SALES_LOOKUP_TABLE=artemis_sales_postgres_financiers
POSTHOG_ARTEMIS_SALES_PROJECTS_TABLE=artemis_sales_postgres_projects
POSTHOG_ARTEMIS_SALES_ORGANIZATIONS_TABLE=artemis_sales_postgres_organizations
POSTHOG_APPLICATION_ID_FIELD=application_id
POSTHOG_GOODLEAP_PROJECT_ID_FIELD=project_id
POSTHOG_SOURCE_UPDATED_AT_FIELD=updated_at
POSTHOG_ARTEMIS_SALES_PROJECT_ORGANIZATION_ID_FIELD=organization_id
POSTHOG_ARTEMIS_SALES_ORGANIZATION_NAME_FIELD=name
POSTHOG_PROJECT_URL_PREFIX=https://goodleap.artemis.solar/projects/
POSTHOG_ARTEMIS_SALES_PROJECT_URL_PREFIX=https://sales.artemis.solar/projects/
POSTHOG_PROJECT_URL_SUFFIX=/proposal

# Optional PostHog solar-table overrides
# These defaults reconstruct the project-side Summary and Monthly CSVs.
POSTHOG_GOODLEAP_PROJECTS_TABLE=goodleap_postgres_projects
POSTHOG_GOODLEAP_SOLAR_PANELS_TABLE=goodleap_postgres_solarpanels
POSTHOG_ARTEMIS_SALES_SOLAR_PANELS_TABLE=artemis_sales_postgres_solarpanels
POSTHOG_SOLAR_PROJECT_ID_FIELD=id
POSTHOG_SOLAR_ARRAY_STATS_FIELD=array_stats
POSTHOG_SOLAR_SOURCE_UPDATED_AT_FIELD=updated_at
POSTHOG_SOLAR_PANEL_PROJECT_ID_FIELD=project_id
POSTHOG_SOLAR_PANEL_SEGMENT_FIELD=segment_index
POSTHOG_SOLAR_PANEL_ACTIVE_FIELD=is_active
POSTHOG_SOLAR_PANEL_AZIMUTH_FIELD=azimuth
POSTHOG_SOLAR_PANEL_PITCH_FIELD=pitch

# Managed automatically by setupGoodLeapArchive().
# Do not create or copy these values between independent deployments.
# GOODLEAP_ROOT_FOLDER_ID=
# GOODLEAP_SPREADSHEET_ID=
# GOODLEAP_FORMAT_VERSION=
